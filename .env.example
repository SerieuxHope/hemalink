# ========================================================
# HEMALINK - REAL SMS GATEWAY CONFIGURATION
# ========================================================

# Default demo recipient phone number (India format)
DEFAULT_SMS_RECIPIENT=+917985674878

# OPTION 1: Fast2SMS (Recommended for India: Instant carrier delivery to +91 7985674878)
# Sign up in 1 minute at https://www.fast2sms.com to get your API key from the dashboard
FAST2SMS_API_KEY=

# OPTION 2: Twilio (Global SMS carrier delivery)
# Account SID, Auth Token and Phone Number from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OPTION 3: Custom SMS Gateway Webhook
# POST { "to": "+917985674878", "message": "..." }
SMS_GATEWAY_WEBHOOK_URL=
