# ========================================================
# HEMALINK - REAL SMS GATEWAY CONFIGURATION
# ========================================================

# Default demo recipient phone number (India format)
DEFAULT_SMS_RECIPIENT=+917985674878

# OPTION 0: Gonums (Indian Quick SMS / No-DLT route)
# Sign up at: https://gonums.com to get your API Key
GONUMS_API_KEY=

# OPTION 1: Twilio (Recommended - Free ~$15.50 trial credit upon signup)
# In trial mode, sends directly to your verified signup number (+91 7985674878)
# Sign up at: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OPTION 2: Vonage / Nexmo (Free developer sandbox / trial)
# Sign up at: https://developer.vonage.com
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=HemaLink

# OPTION 3: Textbee (Free open-source Android SMS gateway - 300 free msgs/mo)
# Install Textbee app on your Android phone, connect & grab API key at https://textbee.dev
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# OPTION 4: Fast2SMS (India Quick SMS)
# https://www.fast2sms.com
FAST2SMS_API_KEY=

# OPTION 5: SmsHorizon (500 free trial credits for developers)
# http://smshorizon.co.in
SMSHORIZON_USER=
SMSHORIZON_API_KEY=
SMSHORIZON_SENDER_ID=HEMALK

# OPTION 6: Authkey.io (Free startup/dev credits)
# https://authkey.io
AUTHKEY_API_KEY=
AUTHKEY_SID=1001

# OPTION 7: Custom SMS Webhook
SMS_GATEWAY_WEBHOOK_URL=
